{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "importSorting": true,
  "ignorePatterns": ["packages/test-harness/fixtures/review-plan/**"],
  "semi": false,
  "singleQuote": true,
  "sortImports": {
    "groups": [
      "side_effect_style",
      "side_effect",
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ],
    "newlinesBetween": true,
    "sortSideEffects": false
  },
  "sortPackageJson": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false
}
