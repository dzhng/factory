{
  "name": "@factory/test-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/*.ts --target=bun --outdir=dist",
    "check-types": "tsc --noEmit",
    "lab:git-observation": "bun run src/run-git-observation.ts",
    "lab:provider-capture": "bun run src/run-provider-oracle.ts",
    "lab:journal-crash": "bun run src/run-journal-crash.ts",
    "lab:capture-vertical": "bun run src/run-capture-vertical.ts",
    "lab:provider-clients": "bun run src/refresh-provider-client-inventory.ts",
    "lab:provider-processes": "bun run src/refresh-provider-process-probe.ts",
    "lab:repository-store": "bun run src/run-repository-workbench.ts",
    "lab:pr-workbench": "bun run src/run-pr-workbench.ts",
    "lab:review-plan": "bun run src/run-review-plan.ts",
    "lab:review-execution": "bun run src/run-review-execution.ts",
    "lab:review-cli": "bun run src/run-review-cli.ts",
    "lab:review-pr-cli": "bun run src/run-review-pr-cli.ts",
    "lab:reviewer-isolation": "bun run src/reviewer-isolation.ts",
    "lab:decision-replay": "bun run src/run-decision-replay.ts",
    "lab:localhost-ui": "bun run src/run-local-ui.ts",
    "check:localhost-ui": "bun run src/run-local-ui.ts --check",
    "lint": "oxlint src test docker",
    "test": "bun test"
  },
  "dependencies": {
    "@factory/cli": "workspace:*",
    "@factory/contract": "workspace:*",
    "@factory/domain": "workspace:*",
    "@factory/github": "workspace:*",
    "@factory/repository": "workspace:*",
    "@factory/review": "workspace:*",
    "@factory/review-plan": "workspace:*",
    "@factory/reviewer": "workspace:*",
    "@factory/web": "workspace:*",
    "playwright-core": "1.61.0"
  }
}
