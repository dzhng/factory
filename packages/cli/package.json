{
  "name": "@factory/cli",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "factory": "./dist/factory.js"
  },
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "build": "bun build src/main.ts --target=bun --outfile=dist/factory.js && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "lint": "oxlint src test",
    "test": "bun run test/docker.ts"
  },
  "dependencies": {
    "@factory/capture": "workspace:*",
    "@factory/contract": "workspace:*",
    "@factory/domain": "workspace:*",
    "@factory/github": "workspace:*",
    "@factory/repository": "workspace:*",
    "@factory/review": "workspace:*",
    "@factory/review-plan": "workspace:*",
    "@factory/reviewer": "workspace:*",
    "@factory/runtime-journal": "workspace:*",
    "@factory/web": "workspace:*"
  }
}
