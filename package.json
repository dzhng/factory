{
  "name": "factory",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check-types": "turbo check-types",
    "format": "oxfmt --write --no-error-on-unmatched-pattern .oxfmtrc.json .oxlintrc.json package.json turbo.json tsconfig.json 'apps/**/*.{ts,tsx,js,mjs,cjs,json}' 'packages/**/*.{ts,tsx,js,mjs,cjs,json}' 'scripts/**/*.{ts,tsx,js,mjs,cjs,json}'",
    "format:check": "oxfmt --check --no-error-on-unmatched-pattern .oxfmtrc.json .oxlintrc.json package.json turbo.json tsconfig.json 'apps/**/*.{ts,tsx,js,mjs,cjs,json}' 'packages/**/*.{ts,tsx,js,mjs,cjs,json}' 'scripts/**/*.{ts,tsx,js,mjs,cjs,json}'",
    "lab:provider-capture": "bun run --cwd packages/test-harness lab:provider-capture",
    "lab:journal-crash": "bun run --cwd packages/test-harness lab:journal-crash",
    "lab:git-observation": "bun run --cwd packages/test-harness lab:git-observation",
    "lab:repository-store": "bun run --cwd packages/test-harness lab:repository-store",
    "lab:pr-workbench": "bun run --cwd packages/test-harness lab:pr-workbench",
    "lab:review-plan": "bun run --cwd packages/test-harness lab:review-plan",
    "lab:review-execution": "bun run --cwd packages/test-harness lab:review-execution",
    "lab:review-cli": "bun run --cwd packages/test-harness lab:review-cli",
    "lab:review-pr-cli": "bun run --cwd packages/test-harness lab:review-pr-cli",
    "lab:review-release": "bun run lab:review-cli && bun run lab:review-pr-cli",
    "lab:decision-replay": "bun run --cwd packages/test-harness lab:decision-replay",
    "lab:localhost-ui": "bun run --cwd packages/test-harness lab:localhost-ui",
    "check:localhost-ui": "bun run --cwd packages/test-harness check:localhost-ui",
    "lint": "turbo lint",
    "lab:reviewer-isolation": "bun run --cwd packages/test-harness lab:reviewer-isolation",
    "test": "turbo test --continue"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "26.1.0",
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "turbo": "2.10.3",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14"
}
