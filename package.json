{
  "name": "factory",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check-types": "turbo check-types",
    "format": "oxfmt --write --no-error-on-unmatched-pattern .oxfmtrc.json .oxlintrc.json package.json turbo.json tsconfig.json 'apps/**/*.{ts,tsx,js,mjs,cjs,json}' 'packages/**/*.{ts,tsx,js,mjs,cjs,json}' 'scripts/**/*.{ts,tsx,js,mjs,cjs,json}'",
    "format:check": "oxfmt --check --no-error-on-unmatched-pattern .oxfmtrc.json .oxlintrc.json package.json turbo.json tsconfig.json 'apps/**/*.{ts,tsx,js,mjs,cjs,json}' 'packages/**/*.{ts,tsx,js,mjs,cjs,json}' 'scripts/**/*.{ts,tsx,js,mjs,cjs,json}'",
    "lab:provider-capture": "bun run --cwd packages/test-harness lab:provider-capture",
    "lint": "turbo lint",
    "lab:reviewer-isolation": "bun run --cwd packages/test-harness lab:reviewer-isolation",
    "test": "turbo test --continue"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "26.1.0",
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "turbo": "2.10.3",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14"
}
