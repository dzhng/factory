        "partial coverage action intent",
        "keyboard skip link"
      ]
    },
    {
      "id": "failed-review",
      "description": "failed review and pending trigger",
      "assertions": [
        "named heading and navigation",
        "keyboard skip link"
      ]
    },
    {
      "id": "canonical-decisions",
      "description": "confirmed canonical decision and pending change",
      "assertions": [
        "named heading and navigation",
        "canonical confirmation and pending change labels",
        "decision action intent",
        "keyboard skip link"
      ]
    },
    {
      "id": "detached-head",
      "description": "detached Git observation",
      "assertions": [
        "named heading and navigation",
        "keyboard skip link"
      ]
    },
    {
      "id": "github-unavailable",
      "description": "durable unavailable GitHub observation",
      "assertions": [
        "named heading and navigation",
        "keyboard skip link"
      ]
    },
    {
      "id": "corrupt-data",
      "description": "read-only corrupt repository state",
      "assertions": [
        "read-only failure heading"
      ]
    },
    {
      "id": "upgrade-required",
      "description": "read-only version gate",
      "assertions": [
        "read-only failure heading"
      ]
    }
