      "assertions": [
        "named heading and navigation",
        "keyboard skip link"
      ]
    },
    {
      "id": "active-capture",
      "description": "active multi-harness Session capture",
      "assertions": [
        "named heading and navigation",
        "keyboard skip link"
      ]
    },
    {
