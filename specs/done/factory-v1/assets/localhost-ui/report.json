      "description": "complete workspace review",
      "assertions": [
        "named heading and navigation",
        "keyboard skip link"
      ]
    },
    {
      "id": "exact-pr",
      "description": "exact PR association",
      "assertions": [
        "named heading and navigation",
        "exact association label",
        "keyboard skip link"
      ]
    },
    {
      "id": "ambiguous-pr",
      "description": "partial PR without exact association",
      "assertions": [
        "named heading and navigation",
        "ambiguous association label",
        "keyboard skip link"
      ]
    },
    {
      "id": "partial-coverage",
      "description": "partial review with unsettled evidence",
      "assertions": [
        "named heading and navigation",
